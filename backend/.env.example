# Paper Graph Manager - 环境变量配置

# LLM 配置（OpenAI）
LLM_API_KEY=your-openai-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.5

# 引用关系同步（Semantic Scholar Graph API，可选；配置后限额更稳定）
# SEMANTIC_SCHOLAR_API_KEY=

# 论文雷达 embedding。默认复用 daily arxiv 的本地 SentenceTransformer 配置。
RADAR_EMBEDDING_PROVIDER=local
RADAR_EMBEDDING_MODEL=jinaai/jina-embeddings-v5-text-nano-retrieval
RADAR_EMBEDDING_TASK=retrieval
RADAR_EMBEDDING_PROMPT_NAME=document
RADAR_EMBEDDING_TRUST_REMOTE_CODE=true
RADAR_EMBEDDING_BATCH_SIZE=64
RADAR_DEBUG=false
# API provider 可选：
# RADAR_EMBEDDING_API_KEY=
# RADAR_EMBEDDING_BASE_URL=https://api.openai.com/v1

# 可选：覆盖默认模型
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
